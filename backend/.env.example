# Enterprise Copilot Studio — Backend environment configuration
# Copy this file to `.env` and adjust values for your environment.
# Nothing here is read directly with os.environ — see app/core/config.py.

# --- Application ---------------------------------------------------------
APP_NAME="Enterprise Copilot Studio API"
APP_ENV=local
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- API -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed origins for the Next.js frontend.
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) --------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecs
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# --- Knowledge ingestion (Sprint 3A) -------------------------------------
STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_MB=25

# --- Vector store (actively required — indexing/retrieval depend on it) ---
# Local dev: docker-compose's own qdrant service, no auth. Production: point
# this at a real, always-reachable Qdrant instance (e.g. Qdrant Cloud) and
# set QDRANT_API_KEY — see README's "Production Deployment: Qdrant" section
# for exact steps. Left commented out (not set to an empty value) on
# purpose: an empty-but-present env var resolves to "" rather than None,
# silently sending an empty api-key header instead of no header at all.
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- LLM provider keys (actively required for real chat responses) --------
LLM_GATEWAY_BASE_URL=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Redis: NOT currently used by any application code ---------------------
# Wired into Settings for a possible future caching/session-storage phase,
# but nothing in the codebase connects to it today (confirmed: grep the repo
# for actual redis client usage — every hit is a comment noting what does
# *not* depend on it, e.g. the /health endpoint and app startup). Safe to
# leave unset; do not deploy a Redis instance in production for this
# version of the app, it would provide zero benefit.
# REDIS_URL=redis://localhost:6379/0

# --- LLM defaults (Sprint 4 — routing/config only, no calls made) ---------
DEFAULT_LLM_PROVIDER=groq
# A current Groq "Production Model" as of this writing -- verify against
# https://console.groq.com/docs/models before relying on it long-term.
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_TOKENS=1024

# --- Enterprise Hybrid Hierarchical RAG (Sprint 3B) -----------------------
QDRANT_COLLECTION_NAME=knowledge_chunks
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
HYBRID_SEMANTIC_TOP_K=10
HYBRID_BM25_TOP_K=10
HYBRID_FINAL_TOP_K=5
CONTEXT_COMPRESSION_MAX_CHUNKS=5
CONTEXT_COMPRESSION_MAX_CHARS_PER_CHUNK=1200
# CHUNK_SIZES is intentionally not set here — pydantic-settings parses
# list-typed env values as JSON, which doesn't mix well with a plain .env
# file (see CORS_ORIGINS above for the same reason it's a string, not a
# list). Its code default is [2048, 512, 128]; override in Python if needed.

# --- Authentication & Authorization (Sprint 6) -----------------------------
# REQUIRED in any real environment: generate a real secret and uncomment
# the line below, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Left commented out (not set to an empty value) on purpose: an empty-but-
# present env var would override the code's safe dev-only default with an
# empty string, which is worse than leaving it unset.
# JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
