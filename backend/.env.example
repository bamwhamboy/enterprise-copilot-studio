# Enterprise Copilot Studio — Backend environment configuration
# Copy this file to `.env` and adjust values for your environment.
# Nothing here is read directly with os.environ — see app/core/config.py.

# --- Application ---------------------------------------------------------
APP_NAME="Enterprise Copilot Studio API"
APP_ENV=local
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- API -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed origins for the Next.js frontend.
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL) --------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecs
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false

# --- Future AI services (configured now, not yet used in code) -------------
# These are wired into Settings and docker-compose so the platform is
# ready for the next phase, but no application code connects to them yet.
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
LLM_GATEWAY_BASE_URL=
GROQ_API_KEY=
OPENAI_API_KEY=
